{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema_output_A5",
  "title": "Output di A5 Challenger (e dei controlli meccanizzati) — esito del ciclo",
  "type": "object",
  "additionalProperties": false,
  "required": ["ciclo", "esito", "rilievi", "sintesi"],
  "properties": {
    "ciclo": {"type": "string", "pattern": "^[0-9]{4}Q[1-4](-S[1-9])?$"},
    "esito": {"type": "string", "enum": ["Approvato", "Da rivedere"]},
    "rilievi": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["controllo", "id_rischio", "gravita", "descrizione"],
        "properties": {
          "controllo": {"type": "string", "enum": ["C1", "C2", "C3", "C4", "C5", "C6", "C7", "C8", "C9"]},
          "id_rischio": {"type": ["string", "null"], "pattern": "^NFR-[0-9]{2}$"},
          "gravita": {"type": "string", "enum": ["Bloccante", "Osservazione"]},
          "descrizione": {"type": "string", "minLength": 10, "maxLength": 800}
        }
      }
    },
    "sintesi": {"type": "string", "minLength": 20, "maxLength": 2000}
  }
}
